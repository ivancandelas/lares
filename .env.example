# ---------------------------------------------------------------------------
# Lares - configuración de ejemplo. Copiar a .env y ajustar.
# ---------------------------------------------------------------------------

# --- Núcleo -----------------------------------------------------------------
LARES_SECRET_KEY=cambia-esto-en-produccion
LARES_DEBUG=true
LARES_ALLOWED_HOSTS=localhost,127.0.0.1
LARES_TIME_ZONE=America/Mexico_City
LARES_LANGUAGE_CODE=es-mx

# --- Base de datos ----------------------------------------------------------
LARES_DATABASE_URL=postgres://lares:lares@localhost:5433/lares

# --- Cola de trabajos -------------------------------------------------------
LARES_REDIS_URL=redis://localhost:6379/0

# --- Modo de despliegue -----------------------------------------------------
# single  -> self-hosted, un solo hogar, sin pantallas de cuenta/billing
# multi   -> SaaS, varios hogares aislados por fila + RLS
LARES_TENANCY_MODE=single

# --- Almacenamiento de archivos ---------------------------------------------
# local | s3
LARES_STORAGE_BACKEND=local
# Vacío = <proyecto>/data/media. En Docker se sobreescribe.
LARES_MEDIA_ROOT=

# --- Despliegue (solo compose.prod.yaml) ------------------------------------
# La contraseña de Postgres. Sin ella el despliegue se niega a arrancar, a
# propósito: una base de datos familiar con la contraseña de ejemplo es una
# base de datos abierta.
POSTGRES_PASSWORD=

# Qué imagen y qué versión se levanta. `make update` cambia LARES_TAG.
# ¿Hay un proxy con HTTPS delante? Si entras por IP en la red de casa, pon 0:
# con 1, todo responde 301 hacia una dirección https que no existe. Sin TLS la
# sesión viaja en claro por tu red local.
LARES_HTTPS=1
# Con proxy delante, el dominio por el que se entra (si no, los formularios
# devuelven un 403 que no explica nada):
# LARES_CSRF_TRUSTED_ORIGINS=https://lares.casa.mx

LARES_IMAGE=ghcr.io/ivancandelas/lares
LARES_TAG=latest
LARES_PORT=8000

# --- Correo (avisos de obligaciones) ----------------------------------------
LARES_EMAIL_URL=consolemail://

# Cómo se llega a esta instalación desde fuera. Los correos con enlace -el
# paquete de sucesión- lo necesitan: una tarea de fondo no tiene petición.
LARES_SITE_URL=http://localhost:8000

# --- Jurisdicción por defecto para los packs de obligaciones ----------------
LARES_DEFAULT_COUNTRY=MX
LARES_DEFAULT_SUBDIVISION=MX-JAL
LARES_DEFAULT_CURRENCY=MXN
